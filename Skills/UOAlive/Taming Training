# True or False to use Peacemaking if needed
enablePeacemaking = False
# True or False to track (pathfind to) the animal being tamed
enableFollowAnimal = True
# Change depending on the latency to your UO shard
journalEntryDelayMilliseconds = 100
targetClearDelayMilliseconds = 100

# Pet release settings (used when Followers exceeds numberOfFollowersToKeep).
# These match the original Razor Enhanced script; they may need adjusting per shard/client.
releaseContextEntry = 9          # Context menu entry for "Release"
releaseConfirmGumpId = 0x5C2226AE # Confirmation gump id
releaseConfirmButton = 2         # "Yes / OK" button on the confirmation gump

# Script timers (milliseconds, matching the original)
noAnimalsToTrainTimerMilliseconds = 10000
catchUpToAnimalTimerMilliseconds = 20000
animalTamingTimerMilliseconds = 13000
peacemakingTimerMilliseconds = 10000
bandageTimerMilliseconds = 5000

# Instrument graphics searched when Peacemaking (lute, harps, drum, tambourines)
